@echo off
chcp 65001 >nul

rem ============================================================================
rem   深圳大学宿舍区校园网 (172.30.255.42) 开机自动认证脚本（通用纯联网版）
rem ============================================================================
rem 【使用说明】
rem 1. 右键本文件 -> 选择“在记事本中编辑”（或打开方式选记事本）
rem 2. 将下方 YOUR_ACCOUNT 改为你的校园网账号，YOUR_PASSWORD 改为你的密码
rem 3. 按 Ctrl+S 保存后，双击运行本文件一次：
rem    - 若弹出安全警告：取消勾选“打开此文件前总是询问”，点击“运行”
rem    - 若弹出管理员权限提示：点击“是”
rem 4. 运行完毕后即可删除本文件，以后插网线开机将零延迟自动完成认证（在家连Wi-Fi会自动退出）
rem ============================================================================

set "SZU_ACCOUNT=YOUR_ACCOUNT"
set "SZU_PASSWORD=YOUR_PASSWORD"

rem ============================================================================
rem   以下为自动配置与运行程序，请勿修改
rem ============================================================================
set "SELF_BAT=%~f0"
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy Bypass -Command "$b64 = (Get-Content -LiteralPath $env:SELF_BAT | Where-Object { $_ -match '^::B64:' }) -replace '^::B64:',''; $code = [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String(($b64 -join ''))); Invoke-Expression $code"
exit /b 0
